# Copie para .env.local e preencha. O .env.local NÃO vai pro git.

# Banco. Local no desenvolvimento; no Render vem do painel.
DATABASE_URL=postgresql://postgres:senha@localhost:5432/jair_veiculos

# Segredo de sessão do next-auth. Gere um: openssl rand -base64 32
AUTH_SECRET=troque-isto
# Necessário atrás do proxy do Render — sem isso o login é recusado.
AUTH_TRUST_HOST=true

# Onde as fotos ficam: "local" grava em .uploads/ (desenvolvimento),
# "r2" manda pra Cloudflare R2 (produção).
ARMAZENAMENTO=local

# Só quando ARMAZENAMENTO=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domínio público do bucket, ex.: https://fotos.jairveiculos.com.br
R2_URL_PUBLICA=

# Endereço público do site, usado no preview de link e no sitemap.
NEXT_PUBLIC_URL_SITE=http://localhost:3000
